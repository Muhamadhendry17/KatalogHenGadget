# Konfigurasi lingkungan untuk server KatalogWA / HenGadget
# Salin berkas ini menjadi .env dan isi nilai yang sesuai.

PORT=3000

# ============================================================================
# DATABASE MYSQL
# ============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hengadget

# ============================================================================
# KEAMANAN
# ============================================================================
# Wajib diisi untuk produksi. Gunakan string acak yang panjang, mis.
# hasil dari: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin yang diizinkan mengakses API (pisahkan dengan koma).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ============================================================================
# FIGMA
# ============================================================================
FIGMA_PERSONAL_ACCESS_TOKEN=
FIGMA_FILE_ID=

